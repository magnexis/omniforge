{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Omniforge Incident Event",
  "type": "object",
  "required": [
    "protocol",
    "incidentId",
    "state",
    "timestamp",
    "source",
    "riskLevel",
    "summary"
  ],
  "properties": {
    "protocol": { "type": "string" },
    "incidentId": { "type": "string", "minLength": 1 },
    "correlationId": { "type": "string" },
    "parentEventId": { "type": "string" },
    "workerId": { "type": "string" },
    "state": {
      "type": "string",
      "enum": [
        "DETECTED",
        "TRIAGED",
        "INVESTIGATING",
        "DIAGNOSED",
        "PLANNED",
        "AWAITING_APPROVAL",
        "REPAIRING",
        "VERIFYING",
        "RESOLVED",
        "ROLLED_BACK",
        "ESCALATED",
        "FAILED",
        "ARCHIVED"
      ]
    },
    "timestamp": { "type": "string" },
    "source": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "riskLevel": { "type": "string" },
    "summary": { "type": "string" },
    "payloadChecksum": { "type": "string" },
    "evidence": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
